# Example environment variables for Orion DeFi Risk Officer
# Copy this to .env and fill in values

# Server port (default 3000)
PORT=3000

# Secret salt for encrypted settings (required in production)
SECRET_SALT=your-secret-salt

# Helius API key for wallet balances and transaction history
HELIUS_API_KEY=your-helIus-api-key

# Solana RPC endpoint (Helius-powered preferred)
SOLANA_RPC_URL=https://rpc.helius.xyz?api-key=${HELIUS_API_KEY}

# Jupiter APIs (auto‑filled defaults, can be overridden)
JUPITER_API_BASE=https://lite-api.jup.ag
JUPITER_PRICE_API=https://price.jup.ag/v3/price
# Optional: Jupiter Portfolio beta API
# JUPITER_PORTFOLIO_API=https://portfolio.jup.ag/v1/

# Telegram bot for alerts (optional)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_CHAT_ID=123456789

# Comma‑separated list of wallets to monitor (optional)
# WATCHED_WALLETS=YourSolanaAddress1,YourSolanaAddress2
